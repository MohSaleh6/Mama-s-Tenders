{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamastenders",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/u/*", "/sitemap.xml", "/robots.txt"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mamastenders",
      "database_id": "4b5a6ffa-3b6c-461a-8c20-2bd7ef59032c",
      "migrations_dir": "migrations"
    }
  ],
  // lets src/seed.js import the schema file as text
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
